{
  "name": "plugin-fast-adapt",
  "version": "0.3.1",
  "description": "DSH 插件升级适配：主入口加四条车道子技能与 DSH 原生插件，直连官方指南，零外部依赖",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "plugin-fast-adapt": "scripts/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml",
    "lib/**/*.js",
    "sub-skills/**/*.md",
    "scripts/**/*.mjs",
    "references/**/*.md",
    "research/**/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/self-test.mjs",
    "run": "node scripts/run.mjs",
    "log": "node scripts/run-log.mjs",
    "release-check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/plugin-fast-adapt.git"
  }
}
