{
  "name": "plugin-fast-adapt",
  "version": "0.4.0",
  "description": "Adapt DeepSeek Harness (DSH) plugins to new host releases: official-guide-driven breaking-change scans, in-memory smoke tests, fleet governance, five-form plugin scaffolding. Agent-native skill, zero dependencies",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "plugin-fast-adapt": "scripts/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "LICENSE",
    "cordis.patch.yml",
    "lib/**/*.js",
    "sub-skills/**/*.md",
    "scripts/**/*.mjs",
    "references/**/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/self-test.mjs",
    "run": "node scripts/run.mjs",
    "log": "node scripts/run-log.mjs",
    "release-check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/plugin-fast-adapt.git"
  }
}
